{
  "name": "cineverse-admin",
  "version": "1.1.0",
  "description": "CineVerse Lotte Admin - Realtime Monitor & Remote Cinema Control App",
  "private": true,
  "scripts": {
    "prepare:www": "node -e \"const fs=require('fs');fs.mkdirSync('www/assets',{recursive:true});fs.copyFileSync('index.html','www/index.html');if(fs.existsSync('_headers'))fs.copyFileSync('_headers','www/_headers');if(fs.existsSync('assets'))fs.cpSync('assets','www/assets',{recursive:true,force:true});\"",
    "cap:sync": "npm run prepare:www && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  }
}
